#!/usr/bin/env lua
-- loglens entry point: `lua bin/loglens report access.log` from a checkout, or `loglens ...` once
-- installed with LuaRocks. All behaviour lives in `loglens.cli`; this file only finds the sources
-- next to it and hands the real environment to `main`.
local script_dir = (arg and arg[0] or ""):match("^(.*)[/\\][^/\\]*$") or "."
package.path = script_dir .. "/../src/?.lua;" .. script_dir .. "/../src/?/init.lua;" .. package.path

local cli = require("loglens.cli")
local platform = require("loglens.platform")

os.exit(cli.main(arg, platform.new()))
